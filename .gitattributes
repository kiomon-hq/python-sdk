# Normalise every text file to LF in the repository and in checkouts, so a
# Windows working copy produces no spurious diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Keep lock files out of language detection and diff noise.
uv.lock linguist-generated=true
